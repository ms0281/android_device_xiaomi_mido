cc_binary {
    name: "vendor.lineage.livedisplay-service.xiaomi_mido",
    init_rc: ["vendor.lineage.livedisplay-service.xiaomi_mido.rc"],
    vintf_fragments: ["vendor.lineage.livedisplay-service.xiaomi_mido.xml"],
    relative_install_path: "hw",
    srcs: [
        "PictureAdjustment.cpp",
        "service.cpp",
    ],
    vendor: true,
    shared_libs: [
        "libbase",
        "libbinder",
        "libbinder_ndk",
        "libcutils",
        "libdl",
        "libutils",
        "vendor.lineage.livedisplay-V1-ndk",
    ],
    header_libs: [
        "vendor.lineage.livedisplay-sdm-headers",
    ],
}
