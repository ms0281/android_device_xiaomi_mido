cc_binary {
    name: "vendor.lineage.touch-service.xiaomi_mido",
    init_rc: ["vendor.lineage.touch-service.xiaomi_mido.rc"],
    vintf_fragments: ["vendor.lineage.touch-service.xiaomi_mido.xml"],
    relative_install_path: "hw",
    proprietary: true,
    srcs: [
        "GloveMode.cpp",
        "KeyDisabler.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
        "libutils",
        "vendor.lineage.touch-V1-ndk",
    ],
}
